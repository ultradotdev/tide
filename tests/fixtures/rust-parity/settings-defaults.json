{
  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.autoIndent": "full",
  "editor.autoClosingBrackets": "always",
  "editor.wordWrap": "on",
  "editor.lineNumbers": "on",
  "editor.folding": true,
  "editor.renderWhitespace": "selection",
  "editor.mouseWheelScrollSensitivity": 3,
  "editor.cursorBlinkRate": 500,
  "editor.scrollBeyondLastLine": true,
  "editor.diagnostics.curlyUnderline": true,
  "editor.undoHistoryLimit": 1000,
  "editor.minimap.enabled": true,
  "editor.minimap.width": 10,
  "editor.minimap.showSlider": "always",
  "editor.minimap.maxColumn": 120,
  "editor.minimap.side": "right",
  "files.autoSave": "off",
  "files.watchFiles": "onFocus",
  "files.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/.DS_Store": true
  },
  "workbench.colorTheme": "ultra-dusk",
  "workbench.startupEditor": "",
  "tui.sidebar.width": 36,
  "tui.sidebar.visible": true,
  "tui.sidebar.location": "left",
  "tui.sidebar.focusedBackground": "#2d3139",
  "tui.agentsSidebar.visible": true,
  "tui.agentsSidebar.width": 36,
  "tui.mainRegion.minimumWidth": 56,
  "tui.terminal.height": 10,
  "tui.terminal.scrollback": 1000,
  "tui.fileTree.showGitStatus": true,
  "tui.iconStyle": "nerd",
  "tui.tabBar.scrollAmount": 1,
  "tui.filePicker.maxFiles": 10000,
  "tui.diffViewer.autoRefresh": true,
  "tui.diffViewer.showDiagnostics": true,
  "tui.diffViewer.editMode": "stage-modified",
  "tui.outline.collapsedOnStartup": true,
  "tui.outline.autoFollow": true,
  "tui.timeline.collapsedOnStartup": true,
  "tui.timeline.mode": "file",
  "tui.timeline.commitCount": 50,
  "git.statusInterval": 500,
  "git.panel.location": "sidebar-bottom",
  "git.panel.openOnStartup": true,
  "git.diffContextLines": 3,
  "git.inlineDiff.maxHeight": 15,
  "git.inlineDiff.contextLines": 3,
  "ai.cli.defaultProvider": "claude-code",
  "ai.builtInConversations.enabled": false,
  "ai.chat.defaultProvider": "claude",
  "ai.chat.defaultModel": "",
  "ai.chat.temperature": 0,
  "ai.panel.defaultWidth": 80,
  "ai.panel.maxWidthPercent": 50,
  "ai.panel.openOnStartup": false,
  "ai.autoStartCli": true,
  "ai.panel.initialPrompt": "You are a helpful software engineer working with another software engineer on a coding project using Tide",
  "ai.streaming.enabled": true,
  "ai.thinking.enabled": true,
  "ai.thinking.completedDisplay": "truncate",
  "ai.thinking.previewLines": 8,
  "ai.reasoning.defaults": {
    "chat": "provider-default",
    "ensembleCoder": "provider-default",
    "ensembleCritic": "provider-default"
  },
  "ai.reasoning.modelOverrides": {},
  "ensemble.asciiIcons": false,
  "ensemble.agents": {
    "coder": {
      "id": "coder",
      "role": "coder",
      "provider": "auto",
      "displayName": "Coder",
      "mention": "coder"
    },
    "critics": [
      {
        "id": "critic-1",
        "role": "critic",
        "provider": "auto",
        "displayName": "Correctness",
        "mention": "correctness",
        "specialty": {
          "name": "Correctness",
          "instructions": "Prioritize behavioral correctness, edge cases, error handling, and regressions."
        }
      },
      {
        "id": "critic-2",
        "role": "critic",
        "provider": "auto",
        "displayName": "Security",
        "mention": "security",
        "specialty": {
          "name": "Security",
          "instructions": "Prioritize trust boundaries, secrets, injection, permissions, data loss, and unsafe operations."
        }
      }
    ]
  },
  "ensemble.reviewPolicy": {
    "preset": "consensus",
    "categoryActions": {},
    "pathRules": [],
    "maxAutoFiles": 10,
    "maxAutoChangedLines": 500,
    "maxCycles": 5,
    "maxValidationRepairs": 3,
    "p0Detection": "safety-or-any-critic",
    "p0Behavior": "pause",
    "applyOnPass": "auto",
    "validationMode": "when-available"
  },
  "session.restoreOnStartup": true,
  "session.autoSave": true,
  "session.autoSaveInterval": 30000,
  "session.databaseQueryHistory": true,
  "session.save.openFiles": true,
  "session.save.cursorPositions": true,
  "session.save.scrollPositions": true,
  "session.save.foldState": true,
  "session.save.uiLayout": true,
  "session.save.unsavedContent": true,
  "lsp.enabled": true,
  "lsp.completionDebounceMs": 250,
  "lsp.triggerCharacters": ".:/<@(",
  "lsp.hover.enabled": true,
  "lsp.signatureHelp.enabled": true,
  "lsp.signatureHelp.display": "popup",
  "lsp.diagnostics.enabled": true,
  "lsp.diagnostics.showInGutter": true,
  "lsp.diagnostics.underlineErrors": true,
  "lsp.diagnostics.delay": 500
}
