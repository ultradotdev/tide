  "git.stashDrop": { "label": "Drop Stash", "category": "Git", "description": "Drop a stash" },
  "git.stashList": { "label": "List Stashes", "category": "Git", "description": "Show all stashes" },
  "git.log": { "label": "View Log", "category": "Git", "description": "Show commit history" },
  "git.logFile": { "label": "View File History", "category": "Git", "description": "Show file commit history" },
  "git.blame": { "label": "Toggle Blame", "category": "Git", "description": "Show line-by-line blame" },
  "git.diff": { "label": "View Diff", "category": "Git", "description": "Show diff for file" },
  "git.diffStaged": { "label": "View Staged Diff", "category": "Git", "description": "Show staged changes" },
  "git.createBranch": { "label": "Create Branch...", "category": "Git", "description": "Create a new branch" },
  "git.switchBranch": { "label": "Switch Branch...", "category": "Git", "description": "Switch to another branch" },
  "git.deleteBranch": { "label": "Delete Branch...", "category": "Git", "description": "Delete a branch" },
  "git.renameBranch": { "label": "Rename Branch...", "category": "Git", "description": "Rename current branch" },
  "git.merge": { "label": "Merge Branch...", "category": "Git", "description": "Merge a branch" },
  "git.abortMerge": { "label": "Abort Merge", "category": "Git", "description": "Abort current merge" },
  "git.remotes": { "label": "Manage Remotes", "category": "Git", "description": "View and manage remotes" },
  "git.tags": { "label": "List Tags", "category": "Git", "description": "Show all tags" },
  "git.focusPanel": { "label": "Focus Git Panel", "category": "Git" },
  "git.refresh": { "label": "Refresh", "category": "Git", "description": "Refresh git status" },
  "git.discard": { "label": "Discard Changes in Active File", "category": "Git", "description": "Discard unstaged changes in the active file after confirmation" },
  "git.discardAll": { "label": "Discard All Changes", "category": "Git", "description": "Discard unstaged changes in every tracked file after confirmation; untracked files are kept" },
  "git.clean": { "label": "Clean Untracked Files...", "category": "Git", "description": "Delete untracked files after listing them; ignored files are kept" },
  "git.commitAmend": { "label": "Commit (Amend)...", "category": "Git", "description": "Rewrite the last commit with the staged changes and an edited message" },
  "git.pullRebase": { "label": "Pull (Rebase)", "category": "Git", "description": "Pull and replay local commits on top of the upstream" },
  "git.fetchAll": { "label": "Fetch All Remotes", "category": "Git", "description": "Fetch from every remote" },
  "git.pushForce": { "label": "Push (Force with Lease)", "category": "Git", "description": "Replace the remote branch with local history after confirmation, unless it has unfetched commits" },
  "git.rebase": { "label": "Rebase Branch...", "category": "Git", "description": "Rebase the current branch onto another branch" },
  "git.continueRebase": { "label": "Continue Rebase", "category": "Git", "description": "Continue the paused rebase after resolving and staging conflicts" },
  "git.abortRebase": { "label": "Abort Rebase", "category": "Git", "description": "Abort the paused rebase and restore the branch" },
  "git.continue": { "label": "Continue Rebase, Cherry-Pick or Revert", "category": "Git", "description": "Continue whichever operation is paused after resolving and staging conflicts" },
  "git.abort": { "label": "Abort Merge, Rebase, Cherry-Pick or Revert", "category": "Git", "description": "Abort whichever operation is paused, after confirmation, and restore the branch" },
  "git.conflicts": { "label": "Open Conflicted File...", "category": "Git", "description": "Pick a file with merge conflicts to open" },
  "git.cherryPick": { "label": "Cherry-Pick Commit...", "category": "Git", "description": "Apply a commit from another branch to the current branch" },
  "git.revert": { "label": "Revert Commit...", "category": "Git", "description": "Add a commit that undoes a commit" },
  "git.reset": { "label": "Reset to Commit...", "category": "Git", "description": "Move the current branch to a commit, keeping changes (soft, mixed) or discarding them (hard)" },
  "git.createTag": { "label": "Create Tag...", "category": "Git", "description": "Tag the current commit; a message makes it an annotated tag" },

