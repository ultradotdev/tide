  "editor.unfold": { "label": "Unfold", "category": "Editor" },
  "editor.foldAll": { "label": "Fold All", "category": "Editor" },
  "editor.unfoldAll": { "label": "Unfold All", "category": "Editor" },
  "editor.toggleComment": { "label": "Toggle Line Comment", "category": "Editor" },
  "editor.commentLine": { "label": "Add Line Comment", "category": "Editor" },
  "editor.uncommentLine": { "label": "Remove Line Comment", "category": "Editor" },
  "editor.selectLine": { "label": "Select Line", "category": "Editor" },
  "editor.duplicateLine": { "label": "Duplicate Line", "category": "Editor", "description": "Copy the lines under each cursor below them" },
  "editor.duplicateSelection": { "label": "Duplicate Selection", "category": "Editor", "description": "Copy each selection after itself, or the line without a selection" },
  "editor.addCursorAbove": { "label": "Add Cursor Above", "category": "Editor" },
  "editor.addCursorBelow": { "label": "Add Cursor Below", "category": "Editor" },
  "editor.clearCursors": { "label": "Clear Cursors", "category": "Editor" },
  "editor.formatDocument": { "label": "Format Document", "category": "Editor" },
  "editor.formatSelection": { "label": "Format Selection", "category": "Editor", "description": "Format the selection, or the cursor's line, with the language server" },
  "editor.toggleBlockComment": { "label": "Toggle Block Comment", "category": "Editor", "description": "Wrap the selection or line in the language's block comment, or unwrap it" },
  "editor.sortLinesAscending": { "label": "Sort Lines Ascending", "category": "Editor", "description": "Sort the selected lines, or the whole file without a multi-line selection" },
  "editor.sortLinesDescending": { "label": "Sort Lines Descending", "category": "Editor", "description": "Sort the selected lines in reverse, or the whole file without a multi-line selection" },
