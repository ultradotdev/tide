  "editor.foldLevel1": { "label": "Fold Level 1", "category": "Editor", "description": "Fold every outermost region" },
  "editor.foldLevel2": { "label": "Fold Level 2", "category": "Editor", "description": "Fold every region nested two deep" },
  "editor.foldLevel3": { "label": "Fold Level 3", "category": "Editor", "description": "Fold every region nested three deep" },

