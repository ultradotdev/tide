{
  // ═══════════════════════════════════════════════════════════════════════════
  // Command Registry
  //
  // Labels, categories and descriptions for the command palette and the generated
  // command reference. Every entry must route to a workbench command.
  //
  // Format: { "command.id": { "label": "...", "category": "...", "description": "..." } }
  // ═══════════════════════════════════════════════════════════════════════════

  // ─────────────────────────────────────────────────────────────────────────────
  // File Commands
  // ─────────────────────────────────────────────────────────────────────────────
  "file.save": { "label": "Save", "category": "File", "description": "Save the current file" },
  "file.saveAs": { "label": "Save As...", "category": "File", "description": "Save file with a new name" },
  "file.saveAll": { "label": "Save All", "category": "File", "description": "Save all open files" },
  "file.reload": { "label": "Revert File", "category": "File", "description": "Reload the active file from disk" },
  "file.overwrite": { "label": "Overwrite File on Disk", "category": "File", "description": "Write the buffer over an externally changed file after confirmation" },
  "file.open": { "label": "Open File...", "category": "File", "description": "Open a file" },
  "file.new": { "label": "New File", "category": "File", "description": "Create a new file" },
  "file.close": { "label": "Close Tab", "category": "File", "description": "Close the active tab" },
  "file.closeAll": { "label": "Close All", "category": "File", "description": "Close all open files" },
  "file.closeOthers": { "label": "Close Other Tabs", "category": "File", "description": "Close every tab in the pane except the active one, asking about unsaved changes" },
  "file.rename": { "label": "Rename File...", "category": "File", "description": "Rename the active file, or the Explorer selection while the Explorer has focus; open tabs follow" },
  "file.delete": { "label": "Delete File...", "category": "File", "description": "Permanently delete the active file, or the Explorer selection while the Explorer has focus, after confirmation" },
  "file.newFolder": { "label": "New Folder...", "category": "File", "description": "Create a folder beside the active file, or in the Explorer selection's folder" },
  "file.copyPath": { "label": "Copy Path", "category": "File", "description": "Copy the active file's absolute path, or the Explorer selection's" },
  "file.copyRelativePath": { "label": "Copy Relative Path", "category": "File", "description": "Copy the active file's path relative to the workspace, or the Explorer selection's" },
  "file.revealInFinder": { "label": "Reveal in File Manager", "category": "File", "description": "Show the active file, or the Explorer selection, in Finder on macOS or the file manager elsewhere" },

  // ─────────────────────────────────────────────────────────────────────────────
  // Edit Commands
  // ─────────────────────────────────────────────────────────────────────────────
  "edit.undo": { "label": "Undo", "category": "Edit", "description": "Undo last action" },
  "edit.redo": { "label": "Redo", "category": "Edit", "description": "Redo last undone action" },
  "edit.copy": { "label": "Copy", "category": "Edit" },
  "edit.cut": { "label": "Cut", "category": "Edit" },
  "edit.paste": { "label": "Paste", "category": "Edit" },
  "edit.selectAll": { "label": "Select All", "category": "Edit" },
  "edit.selectNextMatch": { "label": "Add Selection to Next Match", "category": "Edit" },
  "edit.selectAllOccurrences": { "label": "Select All Occurrences", "category": "Edit" },
  "edit.moveLinesUp": { "label": "Move Line Up", "category": "Edit", "description": "Move the lines under each cursor up one line" },
  "edit.moveLinesDown": { "label": "Move Line Down", "category": "Edit", "description": "Move the lines under each cursor down one line" },
  "edit.deleteLine": { "label": "Delete Line", "category": "Edit", "description": "Delete the lines under each cursor" },
  "edit.indentLine": { "label": "Indent Line", "category": "Edit", "description": "Indent the lines under each cursor one level" },
  "edit.outdentLine": { "label": "Outdent Line", "category": "Edit", "description": "Remove one level of indentation from the lines under each cursor" },
  "edit.joinLines": { "label": "Join Lines", "category": "Edit", "description": "Join each line with the next, or a selection's lines into one" },
  "edit.transformToUppercase": { "label": "Transform to Uppercase", "category": "Edit", "description": "Upper-case the selection, or the word at the cursor" },
  "edit.transformToLowercase": { "label": "Transform to Lowercase", "category": "Edit", "description": "Lower-case the selection, or the word at the cursor" },
  "edit.transformToTitleCase": { "label": "Transform to Title Case", "category": "Edit", "description": "Capitalize each word of the selection, or the word at the cursor" },

  // ─────────────────────────────────────────────────────────────────────────────
  // Search Commands
  // ─────────────────────────────────────────────────────────────────────────────
  "search.find": { "label": "Find", "category": "Search" },
  "search.replace": { "label": "Find and Replace", "category": "Search" },
  "search.findInFiles": { "label": "Find in Files", "category": "Search" },
  "search.replaceInFiles": { "label": "Replace in Files", "category": "Search", "description": "Preview and confirm a replacement across workspace files; open files change in their editors so Undo reverts them" },
  "search.findNext": { "label": "Find Next", "category": "Search" },
  "search.findPrevious": { "label": "Find Previous", "category": "Search" },

