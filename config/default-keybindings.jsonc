[
  // File operations
  { "key": "ctrl+s", "command": "file.save" }, // Save current file
  { "key": "meta+s", "command": "file.save" }, // Save current file (macOS)
  { "key": "ctrl+shift+s", "command": "file.saveAs" }, // Save as new file
  { "key": "shift+meta+s", "command": "file.saveAs" }, // Save as new file (macOS)
  { "key": "ctrl+o", "command": "file.open" }, // Open file
  { "key": "meta+o", "command": "file.open" }, // Open file (macOS)
  { "key": "ctrl+n", "command": "file.new" }, // New file
  { "key": "meta+n", "command": "file.new" }, // New file (macOS)
  { "key": "ctrl+w", "command": "file.close" }, // Close current tab
  { "key": "meta+w", "command": "file.close" }, // Close current tab (macOS)

  // Tab cycling
  { "key": "ctrl+tab", "command": "editor.nextTab" }, // Next tab in pane
  { "key": "ctrl+shift+tab", "command": "editor.previousTab" }, // Previous tab in pane
  { "key": "ctrl+pagedown", "command": "editor.nextTab" }, // Next tab (universal — many terminals can't transmit Ctrl+Tab)
  { "key": "ctrl+pageup", "command": "editor.previousTab" }, // Previous tab (universal)
  { "key": "meta+alt+right", "command": "editor.nextTab" }, // Next tab in pane (macOS)
  { "key": "meta+alt+left", "command": "editor.previousTab" }, // Previous tab in pane (macOS)

  // Edit operations
  { "key": "ctrl+z", "command": "edit.undo" }, // Undo
  { "key": "meta+z", "command": "edit.undo" }, // Undo (macOS)
  { "key": "ctrl+shift+z", "command": "edit.redo" }, // Redo
  { "key": "shift+meta+z", "command": "edit.redo" }, // Redo (macOS)
  { "key": "ctrl+y", "command": "edit.redo" }, // Redo (alternative)
  { "key": "ctrl+c", "command": "edit.copy" }, // Copy selection
  { "key": "meta+c", "command": "edit.copy" }, // Copy selection (macOS)
  { "key": "ctrl+x", "command": "edit.cut" }, // Cut selection
  { "key": "meta+x", "command": "edit.cut" }, // Cut selection (macOS)
  { "key": "ctrl+v", "command": "edit.paste" }, // Paste
  { "key": "meta+v", "command": "edit.paste" }, // Paste (macOS)
  { "key": "ctrl+a", "command": "edit.selectAll" }, // Select all
  { "key": "meta+a", "command": "edit.selectAll" }, // Select all (macOS)

  // Multi-cursor and selection
  { "key": "ctrl+d", "command": "edit.selectNextMatch" }, // Select next occurrence
  { "key": "meta+d", "command": "edit.selectNextMatch" }, // Select next occurrence (macOS)
  { "key": "ctrl+shift+l", "command": "edit.selectAllOccurrences" }, // Select all occurrences
  { "key": "ctrl+alt+up", "command": "editor.addCursorAbove" }, // Add cursor above
  { "key": "ctrl+alt+down", "command": "editor.addCursorBelow" }, // Add cursor below
  { "key": "escape", "command": "editor.clearCursors", "when": "editorHasMultipleCursors" }, // Clear extra cursors

  // Search
  { "key": "ctrl+f", "command": "search.find" }, // Find in file
  { "key": "meta+f", "command": "search.find" }, // Find in file (macOS)
  { "key": "ctrl+h", "command": "search.replace" }, // Find and replace
  { "key": "meta+h", "command": "search.replace" }, // Find and replace (macOS)
  { "key": "ctrl+shift+f", "command": "search.findInFiles" }, // Find in all files
  { "key": "shift+meta+f", "command": "search.findInFiles" }, // Find in all files (macOS)
  { "key": "ctrl+shift+h", "command": "search.replaceInFiles" }, // Replace in all files
  { "key": "shift+meta+h", "command": "search.replaceInFiles" }, // Replace in all files (macOS)
  { "key": "f3", "command": "search.findNext" }, // Find next match
  { "key": "shift+f3", "command": "search.findPrevious" }, // Find previous match

  // Navigation
  { "key": "ctrl+g", "command": "editor.gotoLine" }, // Go to line number
  { "key": "ctrl+p", "command": "workbench.quickOpen" }, // Quick open file
  { "key": "meta+p", "command": "workbench.quickOpen" }, // Quick open file (macOS)
  { "key": "ctrl+k", "command": "workbench.commandPalette" }, // Command palette (primary — plain control byte, works in every terminal)
  { "key": "ctrl+shift+p", "command": "workbench.commandPalette" }, // Command palette (VS Code; needs a terminal that reports Ctrl+Shift)
  { "key": "shift+meta+p", "command": "workbench.commandPalette" }, // Command palette (macOS)
  { "key": "f1", "command": "workbench.commandPalette" }, // Command palette (fallback in every terminal)
  { "key": "ctrl+t", "command": "workbench.commandPalette" }, // Command palette (also reaches Tide while a terminal pane has focus)
  { "key": "ctrl+e", "command": "workbench.commandPalette" }, // Command palette (passes through VS Code's and Zellij's terminals)
  { "key": "meta+e", "command": "workbench.commandPalette" }, // Command palette (macOS alt)
  { "key": "ctrl+r", "command": "editor.gotoSymbol" },
  { "key": "meta+r", "command": "editor.gotoSymbol" }, // Go to symbol in file (macOS)
  { "key": "ctrl+shift+r", "command": "editor.gotoWorkspaceSymbol" }, // Go to symbol in workspace
  { "key": "shift+meta+r", "command": "editor.gotoWorkspaceSymbol" }, // Go to symbol in workspace (macOS)

  // Pane navigation
  { "key": "f6", "command": "workbench.focusNextRegion" }, // Focus next workbench region
  { "key": "shift+f6", "command": "workbench.focusPreviousRegion" }, // Focus previous workbench region
  { "key": "shift+meta+]", "command": "workbench.focusNextRegion" }, // Focus next workbench region (macOS)
  { "key": "shift+meta+[", "command": "workbench.focusPreviousRegion" }, // Focus previous workbench region (macOS)
  { "key": "ctrl+alt+]", "command": "workbench.focusNextRegion" }, // Focus next workbench region (control alternate)
  { "key": "ctrl+alt+[", "command": "workbench.focusPreviousRegion" }, // Focus previous workbench region (control alternate)
  { "key": "ctrl+shift+a", "command": "pane.addPanel" }, // Add tab to focused main pane
  { "key": "shift+meta+a", "command": "pane.addPanel" }, // Add tab to focused main pane (macOS)
  { "key": "ctrl+]", "command": "workbench.focusNextPane" }, // Focus next main pane
  { "key": "meta+]", "command": "workbench.focusNextPane" }, // Focus next main pane (macOS)
  { "key": "ctrl+[", "command": "workbench.focusPreviousPane" }, // Focus previous main pane
  { "key": "meta+[", "command": "workbench.focusPreviousPane" }, // Focus previous main pane (macOS)

  // View
  { "key": "ctrl+shift+b", "command": "workbench.toggleSidebar" }, // Toggle sidebar
  { "key": "ctrl+`", "command": "workbench.toggleTerminal" }, // Toggle bottom terminal
  { "key": "ctrl+\\", "command": "view.splitVertical" }, // Split main pane vertically
  { "key": "meta+\\", "command": "view.splitVertical" }, // Split main pane vertically (macOS)
  { "key": "ctrl+shift+\\", "command": "view.splitHorizontal" }, // Split main pane horizontally
  { "key": "shift+meta+\\", "command": "view.splitHorizontal" }, // Split main pane horizontally (macOS)
  { "key": "ctrl+1", "command": "workbench.focusEditor1" }, // Focus first main pane
  { "key": "ctrl+2", "command": "workbench.focusEditor2" }, // Focus second main pane
  { "key": "ctrl+3", "command": "workbench.focusEditor3" }, // Focus third main pane

  // Line operations
  { "key": "ctrl+l", "command": "editor.selectLine" }, // Select current line
  { "key": "meta+l", "command": "editor.selectLine" }, // Select current line (macOS)
  { "key": "ctrl+shift+d", "command": "editor.duplicateSelection" }, // Duplicate selection
  { "key": "ctrl+shift+up", "command": "edit.moveLinesUp", "when": "editorFocus" }, // Move line up
  { "key": "ctrl+shift+down", "command": "edit.moveLinesDown", "when": "editorFocus" }, // Move line down
  { "key": "shift+meta+k", "command": "edit.deleteLine", "when": "editorFocus" }, // Delete line (macOS)

  // Terminal
  { "key": "ctrl+shift+`", "command": "terminal.new" }, // Open bottom terminal tab
  { "key": "ctrl+shift+t", "command": "terminal.newInPane" }, // Open terminal tab in main pane
  { "key": "meta+k", "command": "terminal.clear", "when": "terminalFocus" }, // Clear terminal (macOS, like iTerm's Cmd+K)
  { "key": "ctrl+shift+k", "command": "terminal.clear", "when": "terminalFocus" }, // Clear terminal
  { "key": "ctrl+shift+home", "command": "terminal.scrollToTop", "when": "terminalFocus" }, // Scroll terminal to top
  { "key": "ctrl+shift+end", "command": "terminal.scrollToBottom", "when": "terminalFocus" }, // Scroll terminal to bottom

  // Git
  { "key": "ctrl+shift+g", "command": "git.focusPanel" }, // Focus git panel

  // AI CLI sessions
  { "key": "ctrl+shift+i", "command": "aiCli.toggle" }, // Toggle AI CLI pane
  { "key": "shift+meta+i", "command": "aiCli.toggle" }, // Toggle AI CLI pane (macOS)
  { "key": "ctrl+shift+j", "command": "agents.openSession" }, // Open any agent session
  { "key": "shift+meta+j", "command": "agents.openSession" }, // Open any agent session (macOS)

  // Git Panel (context: gitPanelFocus)
  { "key": "s", "command": "gitPanel.stage", "when": "gitPanelFocus" }, // Stage file
  { "key": "shift+s", "command": "gitPanel.stageAll", "when": "gitPanelFocus" }, // Stage all files
  { "key": "u", "command": "gitPanel.unstage", "when": "gitPanelFocus" }, // Unstage file
  { "key": "d", "command": "gitPanel.discard", "when": "gitPanelFocus" }, // Discard changes
  { "key": "Enter", "command": "gitPanel.openDiff", "when": "gitPanelFocus" }, // Open diff
  { "key": "o", "command": "gitPanel.openFile", "when": "gitPanelFocus" }, // Open file
  { "key": "r", "command": "gitPanel.refresh", "when": "gitPanelFocus" }, // Refresh status
  { "key": "c", "command": "gitPanel.commit", "when": "gitPanelFocus" }, // Commit
  { "key": " ", "command": "gitPanel.toggleSection", "when": "gitPanelFocus" }, // Collapse or expand the selected group (space)
  { "key": "ArrowUp", "command": "gitPanel.moveUp", "when": "gitPanelFocus" }, // Move up
  { "key": "ArrowDown", "command": "gitPanel.moveDown", "when": "gitPanelFocus" }, // Move down
  { "key": "k", "command": "gitPanel.moveUp", "when": "gitPanelFocus" }, // Move up (vim)
  { "key": "j", "command": "gitPanel.moveDown", "when": "gitPanelFocus" }, // Move down (vim)

  // File Tree (context: fileTreeFocus)
  { "key": "ArrowUp", "command": "fileTree.moveUp", "when": "fileTreeFocus" }, // Move up
  { "key": "ArrowDown", "command": "fileTree.moveDown", "when": "fileTreeFocus" }, // Move down
  { "key": "ArrowRight", "command": "fileTree.expand", "when": "fileTreeFocus" }, // Expand folder
  { "key": "ArrowLeft", "command": "fileTree.collapse", "when": "fileTreeFocus" }, // Collapse folder
  { "key": "Enter", "command": "fileTree.open", "when": "fileTreeFocus" }, // Open file/toggle folder
  { "key": " ", "command": "fileTree.open", "when": "fileTreeFocus" }, // Open file/toggle folder (space)
  { "key": "n", "command": "fileTree.newFile", "when": "fileTreeFocus" }, // New file
  { "key": "shift+n", "command": "fileTree.newFolder", "when": "fileTreeFocus" }, // New folder
  { "key": "r", "command": "fileTree.rename", "when": "fileTreeFocus" }, // Rename
  { "key": "F2", "command": "fileTree.rename", "when": "fileTreeFocus" }, // Rename (F2)
  { "key": "d", "command": "fileTree.delete", "when": "fileTreeFocus" }, // Delete
  { "key": "Delete", "command": "fileTree.delete", "when": "fileTreeFocus" }, // Delete
  { "key": "k", "command": "fileTree.moveUp", "when": "fileTreeFocus" }, // Move up (vim)
  { "key": "j", "command": "fileTree.moveDown", "when": "fileTreeFocus" }, // Move down (vim)
  { "key": "l", "command": "fileTree.expand", "when": "fileTreeFocus" }, // Expand (vim)
  { "key": "h", "command": "fileTree.collapse", "when": "fileTreeFocus" }, // Collapse (vim)
  { "key": "Home", "command": "fileTree.goToFirst", "when": "fileTreeFocus" }, // First
  { "key": "End", "command": "fileTree.goToLast", "when": "fileTreeFocus" }, // Last
  { "key": "PageUp", "command": "fileTree.pageUp", "when": "fileTreeFocus" }, // Page up
  { "key": "PageDown", "command": "fileTree.pageDown", "when": "fileTreeFocus" }, // Page down

  // Outline Panel (context: outlinePanelFocus)
  { "key": "ArrowUp", "command": "outlinePanel.moveUp", "when": "outlinePanelFocus" }, // Move up
  { "key": "ArrowDown", "command": "outlinePanel.moveDown", "when": "outlinePanelFocus" }, // Move down
  { "key": "ArrowRight", "command": "outlinePanel.expand", "when": "outlinePanelFocus" }, // Expand
  { "key": "ArrowLeft", "command": "outlinePanel.collapse", "when": "outlinePanelFocus" }, // Collapse
  { "key": " ", "command": "outlinePanel.toggleExpand", "when": "outlinePanelFocus" }, // Toggle expand (space)
  { "key": "Enter", "command": "outlinePanel.select", "when": "outlinePanelFocus" }, // Go to symbol
  { "key": "PageUp", "command": "outlinePanel.pageUp", "when": "outlinePanelFocus" }, // Page up
  { "key": "PageDown", "command": "outlinePanel.pageDown", "when": "outlinePanelFocus" }, // Page down
  { "key": "Home", "command": "outlinePanel.goToFirst", "when": "outlinePanelFocus" }, // First
  { "key": "End", "command": "outlinePanel.goToLast", "when": "outlinePanelFocus" }, // Last
  { "key": "k", "command": "outlinePanel.moveUp", "when": "outlinePanelFocus" }, // Move up (vim)
  { "key": "j", "command": "outlinePanel.moveDown", "when": "outlinePanelFocus" }, // Move down (vim)
  { "key": "l", "command": "outlinePanel.expand", "when": "outlinePanelFocus" }, // Expand (vim)
  { "key": "h", "command": "outlinePanel.collapse", "when": "outlinePanelFocus" }, // Collapse (vim)

  // Timeline Panel (context: timelinePanelFocus)
  { "key": "ArrowUp", "command": "timelinePanel.moveUp", "when": "timelinePanelFocus" }, // Move up
  { "key": "ArrowDown", "command": "timelinePanel.moveDown", "when": "timelinePanelFocus" }, // Move down
  { "key": "PageUp", "command": "timelinePanel.pageUp", "when": "timelinePanelFocus" }, // Page up
  { "key": "PageDown", "command": "timelinePanel.pageDown", "when": "timelinePanelFocus" }, // Page down
  { "key": "Home", "command": "timelinePanel.goToFirst", "when": "timelinePanelFocus" }, // First
  { "key": "End", "command": "timelinePanel.goToLast", "when": "timelinePanelFocus" }, // Last
  { "key": "g", "command": "timelinePanel.goToFirst", "when": "timelinePanelFocus" }, // First (vim)
  { "key": "shift+g", "command": "timelinePanel.goToLast", "when": "timelinePanelFocus" }, // Last (vim)
  { "key": "Enter", "command": "timelinePanel.viewDiff", "when": "timelinePanelFocus" }, // View diff
  { "key": "o", "command": "timelinePanel.openFileAtCommit", "when": "timelinePanelFocus" }, // Open file at commit
  { "key": "Tab", "command": "timelinePanel.toggleMode", "when": "timelinePanelFocus" }, // Toggle file/repo mode
  { "key": "k", "command": "timelinePanel.moveUp", "when": "timelinePanelFocus" }, // Move up (vim)
  { "key": "j", "command": "timelinePanel.moveDown", "when": "timelinePanelFocus" }, // Move down (vim)
  { "key": "y", "command": "timelinePanel.copyHash", "when": "timelinePanelFocus" }, // Copy commit hash

  // Query Results (context: queryResultsFocus)
  { "key": "ArrowUp", "command": "queryResults.moveUp", "when": "queryResultsFocus" }, // Move up
  { "key": "ArrowDown", "command": "queryResults.moveDown", "when": "queryResultsFocus" }, // Move down
  { "key": "ArrowLeft", "command": "queryResults.moveLeft", "when": "queryResultsFocus" }, // Move left
  { "key": "ArrowRight", "command": "queryResults.moveRight", "when": "queryResultsFocus" }, // Move right
  { "key": "PageUp", "command": "queryResults.pageUp", "when": "queryResultsFocus" }, // Page up
  { "key": "PageDown", "command": "queryResults.pageDown", "when": "queryResultsFocus" }, // Page down
  { "key": "Home", "command": "queryResults.goToFirst", "when": "queryResultsFocus" }, // First
  { "key": "End", "command": "queryResults.goToLast", "when": "queryResultsFocus" }, // Last
  { "key": "Enter", "command": "queryResults.showDetails", "when": "queryResultsFocus" }, // Show row details
  { "key": "r", "command": "queryResults.refresh", "when": "queryResultsFocus" }, // Refresh query
  { "key": "F5", "command": "queryResults.refresh", "when": "queryResultsFocus" }, // Refresh query
  { "key": "e", "command": "queryResults.export", "when": "queryResultsFocus" }, // Export results
  { "key": "s", "command": "queryResults.sort", "when": "queryResultsFocus" }, // Sort by column
  { "key": "Tab", "command": "queryResults.toggleViewMode", "when": "queryResultsFocus" }, // Toggle view mode
  { "key": "k", "command": "queryResults.moveUp", "when": "queryResultsFocus" }, // Move up (vim)
  { "key": "j", "command": "queryResults.moveDown", "when": "queryResultsFocus" }, // Move down (vim)
  { "key": "h", "command": "queryResults.moveLeft", "when": "queryResultsFocus" }, // Move left (vim)
  { "key": "l", "command": "queryResults.moveRight", "when": "queryResultsFocus" }, // Move right (vim)

  // SQL Editor (context: sqlEditorFocus)
  { "key": "ctrl+r", "command": "database.executeQuery", "when": "sqlEditorFocus" },
  { "key": "ctrl+enter", "command": "database.executeQuery", "when": "sqlEditorFocus" }, // Execute query
  { "key": "F5", "command": "database.executeQuery", "when": "sqlEditorFocus" }, // Execute query (compatibility)
  { "key": "ctrl+shift+c", "command": "database.connect", "when": "sqlEditorFocus" }, // Select connection

  // Application
  { "key": "ctrl+q", "command": "workbench.quit" }, // Quit application
  { "key": "meta+q", "command": "workbench.quit" }, // Quit application (macOS)
  { "key": "ctrl+,", "command": "workbench.openSettings" }, // Open settings
  { "key": "meta+,", "command": "workbench.openSettings" }, // Open settings (macOS)
  { "key": "ctrl+shift+,", "command": "workbench.openKeybindings" }, // Open keybindings

  // Folding
  { "key": "ctrl+shift+[", "command": "editor.fold" }, // Fold region
  { "key": "ctrl+shift+]", "command": "editor.unfold" }, // Unfold region

  // Comments
  { "key": "ctrl+/", "command": "editor.toggleComment" }, // Toggle comment
  { "key": "meta+/", "command": "editor.toggleComment" }, // Toggle comment (macOS)
  { "key": "alt+shift+a", "command": "editor.toggleBlockComment", "when": "editorFocus" }, // Toggle block comment

  // LSP
  { "key": "ctrl+shift+k", "command": "lsp.goToDefinition" }, // Go to definition
  { "key": "ctrl+i", "command": "lsp.showHover" }, // Show hover info (type info, docs)
  { "key": "ctrl+space", "command": "lsp.triggerCompletion" }, // Trigger autocomplete
  { "key": "ctrl+shift+space", "command": "lsp.triggerSignatureHelp" }, // Show signature help

  // Terminal-friendly additions
  { "key": "ctrl+.", "command": "lsp.codeActions", "when": "editorFocus" }, // Code actions
  { "key": "ctrl+alt+a", "command": "agents.openSession" }, // Open any agent session
  { "key": "ctrl+space", "command": "database.complete", "when": "sqlEditorFocus" }, // Complete SQL
  { "key": "ctrl+alt+up", "command": "workbench.focusPaneUp", "when": "!editorFocus" }, // Focus the pane above
  { "key": "ctrl+alt+down", "command": "workbench.focusPaneDown", "when": "!editorFocus" } // Focus the pane below
]
