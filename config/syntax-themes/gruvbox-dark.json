{
  "themeId": "gruvbox-dark",
  "sourceRevision": "5d15b2765f59754d7ac263c88a0f6e3e58124951",
  "sourceFormat": "vim-highlight-groups",
  "tokenColors": [
    {
      "name": "Normal",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#ebdbb2"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Todo",
      "scope": [
        "comment keyword.codetag",
        "comment markup.todo"
      ],
      "settings": {
        "foreground": "#ebdbb2",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Error",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#fb4934",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Special",
      "scope": [
        "constant.character.escape",
        "keyword.other.special"
      ],
      "settings": {
        "foreground": "#fe8019"
      }
    },
    {
      "name": "Statement",
      "scope": [
        "keyword",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "name": "Conditional",
      "scope": [
        "keyword.control.conditional"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "name": "Repeat",
      "scope": [
        "keyword.control.repeat"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "name": "Exception",
      "scope": [
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ebdbb2"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword.other"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "name": "Identifier",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#83a598"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#b8bb26",
        "fontStyle": "bold"
      }
    },
    {
      "name": "PreProc",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "Include",
      "scope": [
        "keyword.control.import",
        "meta.preprocessor.include"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "Define",
      "scope": [
        "meta.preprocessor.macro"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.preprocessor",
        "meta.preprocessor.macro"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "PreCondit",
      "scope": [
        "meta.preprocessor.conditional"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Character",
      "scope": [
        "constant.character"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Float",
      "scope": [
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Type",
      "scope": [
        "storage.type",
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "name": "StorageClass",
      "scope": [
        "storage.modifier",
        "storage.type"
      ],
      "settings": {
        "foreground": "#fe8019"
      }
    },
    {
      "name": "Structure",
      "scope": [
        "storage.type.struct",
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "Typedef",
      "scope": [
        "storage.type.typedef",
        "entity.name.type.typedef"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "name": "Underlined",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#83a598"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#b8bb26",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown lower headings",
      "scope": [
        "markup.heading.3",
        "markup.heading.4",
        "markup.heading.5",
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#fabd2f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "Markdown quote and lists",
      "scope": [
        "markup.quote",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#928374"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#d3869b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ebdbb2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#bdae93",
        "fontStyle": "italic"
      }
    }
  ]
}
