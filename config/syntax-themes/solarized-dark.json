{
  "themeId": "solarized-dark",
  "sourceRevision": "528a59f26d12278698bb946f8fb82a63711eec21",
  "sourceFormat": "vim-highlight-groups",
  "tokenColors": [
    {
      "name": "Normal",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#839496"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#586e75",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Character",
      "scope": [
        "constant.character"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Float",
      "scope": [
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
