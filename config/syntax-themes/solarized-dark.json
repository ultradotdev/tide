      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "SpecialChar",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "Delimiter",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "SpecialComment",
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "Debug",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "Underlined",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#6c71c4"
      }
    },
    {
      "name": "Error",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#dc322f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Todo",
      "scope": [
        "comment keyword.codetag",
        "comment markup.todo"
      ],
      "settings": {
        "foreground": "#d33682",
