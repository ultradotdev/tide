        "support.function"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "Statement",
      "scope": [
        "keyword",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Conditional",
      "scope": [
        "keyword.control.conditional"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Repeat",
      "scope": [
        "keyword.control.repeat"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword.other"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Exception",
      "scope": [
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "PreProc",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
