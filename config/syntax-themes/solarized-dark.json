    {
      "name": "PreCondit",
      "scope": [
        "meta.preprocessor.conditional"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "Type",
      "scope": [
        "storage.type",
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "StorageClass",
      "scope": [
        "storage.modifier",
        "storage.type"
      ],
      "settings": {
        "foreground": "#b58900"
      }
