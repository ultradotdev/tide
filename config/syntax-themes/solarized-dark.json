      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#d33682"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#268bd2",
