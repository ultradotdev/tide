    "terminal.ansiGreen": "#add991",
    "terminal.ansiYellow": "#eed198",
    "terminal.ansiBlue": "#8ec8eb",
    "terminal.ansiMagenta": "#c0abf5",
    "terminal.ansiCyan": "#92d3da",
    "terminal.ansiWhite": "#cabab7",
    "terminal.ansiBrightBlack": "#91848d",
    "terminal.ansiBrightRed": "#fd9f9f",
    "terminal.ansiBrightGreen": "#bded9f",
    "terminal.ansiBrightYellow": "#fee4b0",
    "terminal.ansiBrightBlue": "#a0dafe",
    "terminal.ansiBrightMagenta": "#d0bffe",
    "terminal.ansiBrightCyan": "#a1e6ee",
    "terminal.ansiBrightWhite": "#e6dbd1",
    "comment.foreground": "#b0a1a6",
    "keyword.foreground": "#c0abf5",
    "string.foreground": "#add991",
    "number.foreground": "#fba37e",
    "operator.foreground": "#88d0c6",
    "function.foreground": "#8ec8eb",
    "type.foreground": "#eed198",
    "variable.foreground": "#e6dbd1",
    "markup.heading": "#92b3f7",
    "markup.bold": "#fba37e",
    "markup.italic": "#eba3d6",
    "markup.list": "#88d0c6",
    "symbolIcon.classForeground": "#eed198",
    "symbolIcon.constantForeground": "#fba37e",
    "symbolIcon.functionForeground": "#8ec8eb",
    "symbolIcon.interfaceForeground": "#88d0c6",
    "symbolIcon.keyForeground": "#92d3da",
    "symbolIcon.keywordForeground": "#c0abf5",
    "symbolIcon.moduleForeground": "#92b3f7",
    "symbolIcon.variableForeground": "#e6dbd1",
    "editor.findMatchForeground": "#0a0a13",
    "statusBarItem.warningForeground": "#282935",
    "editorGutter.background": "#30313d",
    "sideBarSectionHeader.background": "#5c5966",
    "list.hoverBackground": "#51505d",
    "scrollbar.shadow": "#00000099",
    "aiChat.roleBackground": "#464653",
