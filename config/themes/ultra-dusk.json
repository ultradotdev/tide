    "aiChat.systemForeground": "#cabab7",
    "aiChat.errorForeground": "#fd9b9b",
    "aiChat.activeForeground": "#eed198",
    "aiChat.idleForeground": "#b0a1a6",
    "aiChat.contextAdvisoryForeground": "#eed198",
    "aiChat.contextWarningForeground": "#fba37e",
    "aiChat.contextCriticalForeground": "#fd9b9b",
    "aiChat.workingForeground": "#eed198",
    "aiChat.thinkingForeground": "#c8b7c5",
    "aiChat.thinkingBorder": "#57536d",
    "aiChat.thinkingCollapsedForeground": "#b0a1a6",
    "conversation.roleBackground": "#464653",
    "conversation.cardBorder": "#7e7480",
    "conversation.composerBackground": "#30313d",
    "conversation.composerForeground": "#e6dbd1",
    "conversation.headerBackground": "#464653",
    "conversation.headerForeground": "#e6dbd1",
    "conversation.userForeground": "#96b7fb",
    "conversation.assistantForeground": "#c0abf5",
    "conversation.criticForeground": "#c0abf5",
    "conversation.toolForeground": "#8ec8eb",
    "conversation.systemForeground": "#b0a1a6",
    "conversation.validationForeground": "#add991",
    "conversation.proposalForeground": "#add991",
    "conversation.thinkingForeground": "#c8b7c5",
    "conversation.thinkingCollapsedForeground": "#b0a1a6",
    "conversation.workingForeground": "#eed198",
    "conversation.warningForeground": "#eed198",
    "conversation.criticalForeground": "#fd9b9b",
    "conversation.actionBackground": "#484f51",
    "conversation.experimentalBackground": "#49485c",
    "conversation.experimentalForeground": "#c0abf5",
    "conversation.scrollbarThumbBackground": "#8b828d",
    "conversation.scrollbarTrackBackground": "#30313d",
    "ensemble.stageBackground": "#464653",
    "ensemble.stageForeground": "#e6dbd1",
