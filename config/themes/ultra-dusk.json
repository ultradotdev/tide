    "ensemble.thinkingBorder": "#57536d",
    "ensemble.thinkingCollapsedForeground": "#b0a1a6"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b0a1a6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#cabab7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation keyword",
      "scope": [
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "keyword.other.phpdoc"
      ],
      "settings": {
        "foreground": "#88d0c6"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "meta.embedded.assembly"
      ],
      "settings": {
        "foreground": "#add991"
      }
    },
    {
      "name": "String escape and interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#88d0c6"
      }
    },
    {
      "name": "Regular expression",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#eba3d6"
      }
    },
    {
      "name": "Number and boolean",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#fba37e"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.other",
        "constant.language",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#fba37e"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#c0abf5"
      }
    },
    {
      "name": "Storage and modifier",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other.rust",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#c0abf5"
      }
    },
    {
      "name": "Import and export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#c0abf5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.assignment",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#88d0c6"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.bracket",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#cabab7"
      }
    },
    {
      "name": "Function declaration",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function entity.name.function"
      ],
      "settings": {
        "foreground": "#8ec8eb"
      }
    },
    {
      "name": "Function call and method",
      "scope": [
        "meta.function-call",
        "meta.function-call entity.name.function",
        "variable.function",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#8ec8eb"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro",
        "meta.macro"
      ],
      "settings": {
        "foreground": "#f094a2"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#eba3d6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#e6dbd1"
      }
    },
    {
      "name": "Language variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "keyword.other.self"
      ],
      "settings": {
        "foreground": "#f094a2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property and field",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#92d3da"
      }
    },
    {
      "name": "JSON and YAML key",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.yaml",
        "string.quoted.double.json punctuation.support.type.property-name"
      ],
      "settings": {
        "foreground": "#92d3da"
      }
    },
    {
      "name": "Type and class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.type",
        "support.class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#eed198"
      }
    },
    {
      "name": "Interface and trait",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.trait",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#eed198",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Namespace and module",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.scope-resolution",
        "support.module"
      ],
      "settings": {
        "foreground": "#92b3f7"
      }
    },
    {
      "name": "Decorator and annotation",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#f094a2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#92b3f7"
      }
    },
    {
      "name": "Tag attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#eed198",
        "fontStyle": "italic"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML",
        "keyword.other.DDL",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#c0abf5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Shell builtin and variable",
      "scope": [
        "support.function.builtin.shell",
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#8ec8eb"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#92b3f7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#fba37e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#eba3d6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup list",
      "scope": [
        "markup.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#88d0c6"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#92d3da",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inline code and fenced block",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#add991"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#cabab7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#add991"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#f89caa"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#fba37e"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ef8a8b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f094a2",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
