      "settings": {
        "foreground": "#f1fa8c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Horizontal rule (prose)",
      "scope": [
        "meta.separator.markdown"
      ],
      "settings": {
        "foreground": "#6272a4"
      }
    },
    {
      "name": "Code blocks",
