{
  "name": "Solarized Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#002b36",
    "editor.foreground": "#fdf6e3",
    "editor.selectionBackground": "#255660",
    "editorCursor.foreground": "#cb4b16",
    "editorLineNumber.foreground": "#586e75",
    "editorLineNumber.activeForeground": "#fdf6e3",
    "editorGroup.border": "#164651",
    "editorGroupHeader.tabsBackground": "#00242d",
    "editorWidget.background": "#001e26",
    "editorWidget.foreground": "#fdf6e3",
    "editorWidget.border": "#164651",
    "sideBar.background": "#00242d",
    "sideBar.foreground": "#fdf6e3",
    "sideBar.border": "#164651",
    "sideBarTitle.foreground": "#fdf6e3",
    "panel.background": "#002b36",
    "panel.foreground": "#fdf6e3",
    "panel.border": "#164651",
    "tab.activeBackground": "#002b36",
    "tab.activeForeground": "#fdf6e3",
    "tab.inactiveBackground": "#00242d",
    "tab.inactiveForeground": "#93a1a1",
    "tab.border": "#001e26",
    "tab.activeBorderTop": "#268bd2",
    "statusBar.background": "#00242d",
    "statusBar.foreground": "#fdf6e3",
    "input.background": "#001e26",
    "input.foreground": "#fdf6e3",
    "input.border": "#164651",
    "button.background": "#268bd2",
    "button.foreground": "#001e26",
    "list.activeSelectionBackground": "#164651",
    "list.activeSelectionForeground": "#fdf6e3",
    "focusBorder": "#268bd2",
    "descriptionForeground": "#93a1a1",
    "editorError.foreground": "#dc322f",
    "editorWarning.foreground": "#b58900",
    "editorInfo.foreground": "#268bd2",
    "editorHint.foreground": "#2aa198",
    "successForeground": "#859900",
    "gitDecoration.addedResourceForeground": "#859900",
    "gitDecoration.modifiedResourceForeground": "#b58900",
    "gitDecoration.deletedResourceForeground": "#dc322f",
    "gitDecoration.untrackedResourceForeground": "#2aa198",
    "terminal.background": "#002b36",
    "terminal.foreground": "#fdf6e3",
    "terminalCursor.foreground": "#cb4b16",
    "terminal.ansiBlack": "#164651",
    "terminal.ansiRed": "#dc322f",
    "terminal.ansiGreen": "#859900",
    "terminal.ansiYellow": "#b58900",
    "terminal.ansiBlue": "#268bd2",
    "terminal.ansiMagenta": "#6c71c4",
    "terminal.ansiCyan": "#2aa198",
    "terminal.ansiWhite": "#eee8d5",
    "terminal.ansiBrightBlack": "#586e75",
    "terminal.ansiBrightRed": "#dc322f",
    "terminal.ansiBrightGreen": "#859900",
    "terminal.ansiBrightYellow": "#b58900",
    "terminal.ansiBrightBlue": "#268bd2",
    "terminal.ansiBrightMagenta": "#d33682",
    "terminal.ansiBrightCyan": "#2aa198",
    "terminal.ansiBrightWhite": "#fdf6e3",
    "comment.foreground": "#586e75",
    "keyword.foreground": "#6c71c4",
    "string.foreground": "#859900",
    "number.foreground": "#cb4b16",
    "operator.foreground": "#2aa198",
    "function.foreground": "#268bd2",
    "type.foreground": "#b58900",
    "variable.foreground": "#fdf6e3",
    "markup.heading": "#dc322f",
    "markup.bold": "#cb4b16",
    "markup.italic": "#d33682",
    "markup.list": "#2aa198",
    "symbolIcon.classForeground": "#b58900",
    "symbolIcon.constantForeground": "#cb4b16",
    "symbolIcon.functionForeground": "#268bd2",
    "symbolIcon.interfaceForeground": "#2aa198",
    "symbolIcon.keyForeground": "#6c71c4",
    "symbolIcon.keywordForeground": "#6c71c4",
    "symbolIcon.moduleForeground": "#d33682",
    "symbolIcon.variableForeground": "#fdf6e3",
    "editor.lineHighlightBackground": "#073642",
    "editor.findMatchBackground": "#b5890070",
    "editor.findMatchHighlightBackground": "#268bd240"
  },
  "tokenColors": [
    {
      "name": "Normal",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#839496"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#586e75",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Character",
      "scope": [
        "constant.character"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Float",
      "scope": [
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Identifier",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "Statement",
      "scope": [
        "keyword",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Conditional",
      "scope": [
        "keyword.control.conditional"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Repeat",
      "scope": [
        "keyword.control.repeat"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword.other"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Exception",
      "scope": [
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "PreProc",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "Include",
      "scope": [
        "keyword.control.import",
        "meta.preprocessor.include"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "Define",
      "scope": [
        "meta.preprocessor.macro"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.preprocessor",
        "meta.preprocessor.macro"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "PreCondit",
      "scope": [
        "meta.preprocessor.conditional"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "Type",
      "scope": [
        "storage.type",
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "StorageClass",
      "scope": [
        "storage.modifier",
        "storage.type"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "Structure",
      "scope": [
        "storage.type.struct",
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "Typedef",
      "scope": [
        "storage.type.typedef",
        "entity.name.type.typedef"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "Special",
      "scope": [
        "constant.character.escape",
        "keyword.other.special"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "SpecialChar",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "Delimiter",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "SpecialComment",
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "Debug",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "Underlined",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#6c71c4"
      }
    },
    {
      "name": "Error",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#dc322f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Todo",
      "scope": [
        "comment keyword.codetag",
        "comment markup.todo"
      ],
      "settings": {
        "foreground": "#d33682",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#268bd2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#d33682"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#268bd2",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#839496",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#839496",
        "fontStyle": "italic"
      }
    }
  ]
}
