{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultra.dev/schemas/theme-design-response-v1.json",
  "title": "Ultra theme design response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "design",
    "theme",
    "derivationReview"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept",
        "paletteCharacter",
        "surfaceHierarchy",
        "accentStrategy",
        "syntaxStrategy"
      ],
      "properties": {
        "concept": {
          "type": "string",
          "minLength": 1
        },
        "paletteCharacter": {
          "type": "string",
          "minLength": 1
        },
        "surfaceHierarchy": {
          "type": "string",
          "minLength": 1
        },
        "accentStrategy": {
          "type": "string",
          "minLength": 1
        },
        "syntaxStrategy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "colors",
        "tokenColors"
      ],
      "properties": {
        "name": {
          "const": "Ultra Dusk"
        },
        "type": {
          "enum": [
            "dark",
            "light",
            "high-contrast"
          ]
        },
