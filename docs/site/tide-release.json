  "commands": {
    "homebrewInstall": {
      "status": "available",
      "commands": [
        "brew install ultradotdev/tap/tide"
      ]
    },
    "homebrewUpgrade": {
      "status": "available",
      "commands": [
        "brew update && brew upgrade tide"
      ]
    },
    "homebrewUninstall": {
      "status": "available",
      "commands": [
        "brew uninstall tide"
      ]
    },
    "binaryInstall": {
      "status": "available",
      "commands": [
        "curl -fsSL https://github.com/ultradotdev/tide/releases/latest/download/install.sh | sh"
      ]
    },
    "binaryUninstall": {
      "status": "available",
      "commands": [
        "tide --uninstall",
        "curl -fsSL https://github.com/ultradotdev/tide/releases/latest/download/uninstall.sh | sh"
      ]
    },
    "sourceBuild": {
      "status": "available-in-source-checkout",
      "commands": [
        "cargo build --locked --release -p tide",
        "./target/release/tide .",
        "./install-from-source.sh"
      ]
    }
  },
  "paths": {
    "config": "${XDG_CONFIG_HOME:-~/.config}/tide/",
    "data": "${XDG_DATA_HOME:-~/.local/share}/tide/",
    "state": "${XDG_STATE_HOME:-~/.local/state}/tide/",
    "cache": "${XDG_CACHE_HOME:-~/.cache}/tide/",
    "workspace": "<workspace>/.tide/"
  },
  "features": {
    "releaseReady": [
      {
        "id": "editor",
        "name": "Code editing",
        "description": "Terminal-native editing with syntax highlighting, LSP integration, panes, and keyboard navigation."
      },
      {
        "id": "git",
        "name": "Git workflows",
        "description": "Source control, diffs, history, staging, commits, and safety-aware destructive actions."
      },
      {
        "id": "terminal",
        "name": "Terminal and TUI applications",
        "description": "Integrated terminal tabs and a bottom dock with standards-oriented TUI compatibility."
      },
      {
        "id": "postgresql",
        "name": "PostgreSQL workspace",
        "description": "Connections, schema browsing, SQL editing, query history, results, and row details."
      },
      {
        "id": "external-ai-cli",
        "name": "External AI CLI integrations",
        "description": "Detected provider tabs and workspace session discovery for five supported AI CLIs."
      },
      {
        "id": "themes",
        "name": "Themes",
        "description": "Thirteen built-in semantic themes with source-backed syntax palettes and Ultra Dusk as the default."
      }
    ],
    "experimental": [],
    "deferred": [
      {
        "id": "wsl",
